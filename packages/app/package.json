{
  "name": "shiftowed",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first PWA that tracks schedule changes and calculates Fair Workweek predictability pay, with a citation next to every dollar.",
  "license": "GPL-3.0-or-later",
  "author": "Joel Stain Lobo (https://github.com/lobojoel2003)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-ocr-assets.mjs && vite",
    "build": "node scripts/copy-ocr-assets.mjs && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@shiftowed/rules": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "idb": "^8.0.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1"
  }
}
