{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lobojoel2003/Shiftowed/blob/main/packages/rules/schema/jurisdiction.schema.json",
  "title": "Shiftowed jurisdiction rules",
  "description": "One Fair Workweek (predictive scheduling) law, expressed as data. Every number carries a citation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "shortName",
    "law",
    "region",
    "timeZone",
    "currency",
    "status",
    "effective",
    "lastVerified",
    "coverage",
    "advanceNotice",
    "premiums",
    "exceptions",
    "enforcement",
    "sources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[a-z0-9]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "shortName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 24
    },
    "law": {
      "type": "string",
      "minLength": 3
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country", "state"],
      "properties": {
        "country": {
          "const": "US"
        },
        "state": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "city": {
          "type": "string"
        },
        "county": {
          "type": "string"
        }
      }
    },
    "timeZone": {
      "type": "string",
      "pattern": "^[A-Za-z_]+/[A-Za-z_/]+$"
    },
    "currency": {
      "const": "USD"
    },
    "status": {
      "enum": ["in-force", "pending", "repealed"]
    },
    "effective": {
      "$ref": "#/$defs/date"
    },
    "lastVerified": {
      "$ref": "#/$defs/date"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "industries", "employerThreshold"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 10
        },
        "industries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "employerThreshold": {
          "type": "string"
        },
        "employees": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "advanceNotice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hours", "label", "citation"],
      "properties": {
        "hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "label": {
          "type": "string"
        },
        "citation": {
          "$ref": "#/$defs/citation"
        }
      }
    },
    "premiums": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/changeRule"
      }
    },
    "prohibitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prohibition"
      }
    },
    "rest": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/restRule"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "description", "citation"],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "citation": {
            "$ref": "#/$defs/citation"
          }
        }
      }
    },
    "otherRights": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "citation"],
        "properties": {
          "label": {
            "type": "string"
          },
          "citation": {
            "$ref": "#/$defs/citation"
          }
        }
      }
    },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agency", "url"],
      "properties": {
        "agency": {
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "complaintUrl": {
          "$ref": "#/$defs/url"
        },
        "phone": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "$ref": "#/$defs/url"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "url": {
      "type": "string",
      "pattern": "^https://"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "url"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 3
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "quote": {
          "type": "string"
        }
      }
    },
    "changeKind": {
      "enum": ["add", "extend", "move", "reduce", "cancel"]
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minHours": {
          "type": "number"
        },
        "maxHours": {
          "type": "number"
        },
        "to": {
          "enum": ["shift", "schedule"],
          "description": "Measure notice to the shift's start (default) or to 12:00 a.m. on the first day of the work schedule."
        }
      }
    },
    "amount": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "dollars"],
          "properties": {
            "type": {
              "const": "flat"
            },
            "dollars": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "hours"],
          "properties": {
            "type": {
              "const": "hoursOfPay"
            },
            "hours": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "prorateAddedHours": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "multiplier"],
          "properties": {
            "type": {
              "enum": ["perLostHour", "perRestHour"]
            },
            "multiplier": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "tiers"],
          "properties": {
            "type": {
              "const": "hoursOfPayByShiftLength"
            },
            "tiers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["hours"],
                "properties": {
                  "maxShiftHours": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "hours": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "maxHours", "of"],
          "properties": {
            "type": {
              "const": "hoursOfPayUpTo"
            },
            "maxHours": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "of": {
              "enum": ["shift", "lost"]
            }
          }
        }
      ]
    },
    "changeRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "group", "label", "on", "notice", "amount", "citation"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "group": {
          "$ref": "#/$defs/slug"
        },
        "label": {
          "type": "string"
        },
        "on": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/changeKind"
          }
        },
        "notice": {
          "$ref": "#/$defs/notice"
        },
        "minChangeMinutes": {
          "type": "integer",
          "minimum": 0,
          "description": "Smallest change in whole minutes that triggers the rule."
        },
        "amount": {
          "$ref": "#/$defs/amount"
        },
        "exceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "citation": {
          "$ref": "#/$defs/citation"
        }
      }
    },
    "restRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "minRestHours", "amount", "citation"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "label": {
          "type": "string"
        },
        "minRestHours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "consecutiveDaysOnly": {
          "type": "boolean"
        },
        "includeSameDayShifts": {
          "type": "boolean"
        },
        "premiumHours": {
          "enum": ["window", "secondShift"]
        },
        "amount": {
          "$ref": "#/$defs/amount"
        },
        "exceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "citation": {
          "$ref": "#/$defs/citation"
        }
      }
    },
    "prohibition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "on", "notice", "citation"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "label": {
          "type": "string"
        },
        "on": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/changeKind"
          }
        },
        "notice": {
          "$ref": "#/$defs/notice"
        },
        "exceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "citation": {
          "$ref": "#/$defs/citation"
        },
        "minChangeMinutes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
